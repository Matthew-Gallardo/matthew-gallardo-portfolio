{
  "name": "matthew-gallardo-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "validate:content": "node --experimental-strip-types scripts/validate-content.ts",
    "build": "npm run validate:content && next build",
    "start": "next start",
    "test:e2e": "playwright test",
    "test:unit": "node --experimental-strip-types --test tests/unit/*.test.ts",
    "test:e2e:all": "playwright test --project=chromium --project=firefox --project=webkit",
    "check": "npm run typecheck && npm run lint && npm run test:unit && npm run build"
  },
  "dependencies": {
    "lucide-react": "1.50.0",
    "motion": "14.0.0",
    "next": "16.3.8",
    "next-themes": "0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "lighthouse": "13.5.0",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
